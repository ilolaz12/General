%% Example 1: simplified modulation
N = 1000;
tmax = 2;
dt = tmax/N;
fc = 40;
fm = 8;
t = 0:dt:tmax;
xc = sin(2*pi*fc*t);
xm = sin(2*pi*fm*t);
mu = 0.25;
xam = (1+mu*xm).*xc;
fs = 1/dt;
f = 0:fs/N:fs;
% shows modulation, carrier and amplitude −modulated
% placing them like this makes it easier to understand
figure (1);
clf
subplot(3, 1, 1);
plot(t, xm);
subplot(3, 1, 2);
plot(t, xc);
subplot(3, 1, 3);
plot(t, xam);

%% Example 2: code for demo dulation via sq u a r i n g
% s q u a r e AM
xam2 = xam.*xam;
% s p e c t r um
plot(f, abs(fft(xam2)));